{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug active C file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/${fileDirnameBasename}/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "C: build active file",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "compounds": [
    {
      "name": "Build and debug active C file",
      "configurations": [
        "Debug active C file"
      ]
    }
  ]
}
