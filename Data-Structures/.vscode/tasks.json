{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: prepare output directory",
      "type": "shell",
      "command": "mkdir",
      "args": [
        "-p",
        "${workspaceFolder}/build/${fileDirnameBasename}"
      ],
      "problemMatcher": []
    },
    {
      "label": "C: build active file",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",
        "${file}",
        "-o",
        "${workspaceFolder}/build/${fileDirnameBasename}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "C: prepare output directory",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Build the currently active C file into the workspace build folder."
    }
  ]
}
